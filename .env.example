# Lead delivery for the homepage form. Copy to .env.local for local dev and add the same
# variables in Vercel > Project > Settings > Environment Variables for production.
#
# Recipient. Defaults to the site contact email (TrussHQ@gmail.com) when empty.
LEAD_TO_EMAIL=TrussHQ@gmail.com

# Option 1 (recommended): send from the TrussHQ Gmail account with an App Password.
# Google Account > Security > 2-Step Verification (must be on) > App passwords > create one for "Truss site".
GMAIL_USER=TrussHQ@gmail.com
GMAIL_APP_PASSWORD=

# Option 2: Resend (https://resend.com). Used only when the Gmail variables are empty.
RESEND_API_KEY=
LEAD_FROM_EMAIL=

# Optional: also POST each lead as JSON to a webhook (Zapier, Make, Slack, CRM).
LEAD_WEBHOOK_URL=
